---
interface Props {
  src: string;
  caption?: string;
  alt?: string;
}

const { src, caption, alt } = Astro.props;
---

<figure>
  <img src={src} alt={alt || caption || ''} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure {
    margin: 1.5rem 0;
    text-align: center;
  }
  figure img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: #666;
  }
</style>
