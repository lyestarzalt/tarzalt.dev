---
import { Image } from 'astro:assets';
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  lastmod?: Date;
  tags?: string[];
  featuredImage?: ImageMetadata;
}

const { title, description, date, lastmod, tags = [], featuredImage } = Astro.props;

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<Base title={title} description={description}>
  <article>
    <header class="post-header">
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {lastmod && (
          <>
            <span class="meta-sep">&middot;</span>
            <span>updated {formatDate(lastmod)}</span>
          </>
        )}
      </div>
      <h1>{title}</h1>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>
    {featuredImage && (
      <div class="featured-image">
        <Image src={featuredImage} alt={title} width={960} densities={[1, 2]} />
      </div>
    )}
    <div class="prose">
      <slot />
    </div>
    <footer class="post-footer">
      <a href="/blog/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        All posts
      </a>
    </footer>
  </article>
</Base>

<style>
  .post-header {
    margin-bottom: 2rem;
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    letter-spacing: 0.02em;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .meta-sep {
    opacity: 0.3;
  }

  h1 {
    font-size: 2rem;
    line-height: 1.2;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    padding: 0.1875rem 0.625rem;
    border-radius: 100px;
    letter-spacing: 0.02em;
    transition: all var(--transition);
  }

  .tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ── Featured image ── */
  .featured-image {
    margin-bottom: 3rem;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .featured-image :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0;
  }

  /* ── Prose ── */
  .prose {
    line-height: 1.8;
    color: var(--text-secondary);
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .prose :global(h2) {
    font-size: 1.375rem;
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--text);
    position: relative;
    padding-top: 1.5rem;
  }

  .prose :global(h2)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 2rem;
    height: 1px;
    background: var(--accent);
  }

  .prose :global(h3) {
    font-size: 1.125rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text);
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.25rem;
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 500;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: rgba(201, 149, 107, 0.3);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition);
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .prose :global(img) {
    margin: 2rem 0;
    border: 1px solid var(--border);
  }

  .prose :global(figure) {
    margin: 2rem 0;
  }

  .prose :global(figcaption) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    text-align: center;
    margin-top: 0.75rem;
  }

  /* ── Post footer ── */
  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    h1 { font-size: 1.625rem; }
    .prose :global(h2) { font-size: 1.25rem; }
  }
</style>
