---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import { Separator } from '@/components/ui/separator';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Lyes Tarzalt - Software engineer writing about parsing, flight simulation tools, and building practical software.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      crossorigin="anonymous"
    />
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (t === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <div class="mx-auto flex min-h-screen max-w-2xl flex-col px-6">
      <Header />
      <main class="flex-1 py-4 pb-16">
        <slot />
      </main>
      <footer class="py-6">
        <Separator className="mb-6" />
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
          <span>Lyes Tarzalt</span>
          <span class="opacity-30">/</span>
          <span>{new Date().getFullYear()}</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @reference "@/styles/global.css";

  /* Code blocks */
  pre {
    @apply !rounded-lg !border !border-border !bg-card !p-5 !text-[0.8125rem] !leading-relaxed;
    font-family: 'JetBrains Mono', var(--font-mono, monospace);
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  code {
    font-family: 'JetBrains Mono', var(--font-mono, monospace);
    font-size: 0.875em;
  }
  :not(pre) > code {
    @apply rounded-sm bg-muted px-1.5 py-0.5 text-[0.8125em] text-foreground;
  }

  /* Shiki dual theme */
  .dark pre code .line span { color: var(--shiki-dark, inherit) !important; }
  html:not(.dark) pre code .line span { color: var(--shiki-light, inherit) !important; }

  /* Images */
  img { @apply max-w-full h-auto rounded-lg; }

  /* Blockquotes */
  blockquote { @apply border-l-2 border-border rounded-r-md bg-muted/50 px-5 py-3 my-6 text-muted-foreground; }
  blockquote p { @apply m-0; }

  /* GitHub callouts */
  .markdown-alert { @apply border-l-2 border-primary rounded-r-md bg-muted/50 px-5 py-3 my-6; }
  .markdown-alert-title { @apply text-xs font-medium uppercase tracking-wider text-primary mb-2; }

  /* Tables */
  table { @apply w-full border-collapse my-6 text-sm; }
  th { @apply text-xs font-medium uppercase tracking-wider text-muted-foreground text-left p-3 border-b border-border; }
  td { @apply p-3 border-b border-border text-muted-foreground; }
  tr:hover td { @apply bg-muted/50; }

  /* HR */
  hr { @apply border-none border-t border-border my-10; }

  /* Lists */
  ul, ol { @apply pl-5; }
  li { @apply mb-1 text-muted-foreground; }

  /* KaTeX */
  .katex-display { @apply my-6 overflow-x-auto overflow-y-hidden; }

  /* Selection */
  ::selection { @apply bg-primary/15 text-primary; }
</style>
