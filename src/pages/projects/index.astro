---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { Badge } from '@/components/ui/badge';
import PageHeader from '@/components/layout/PageHeader.astro';
import SectionDivider from '@/components/layout/SectionDivider.astro';
import xDispatchMap from '@/assets/projects/x-dispatch/map.png';
import xDispatchIcon from '@/assets/projects/x-dispatch/icon.png';
---

<Base
  title="Projects - Lyes Tarzalt"
  description="Open source projects: X-Dispatch (flight dispatch for X-Plane 12), Dinar Échange (Algerian exchange rates), and more."
>
  <PageHeader title="Projects" subtitle="Things I built because they needed to exist." />

  <SectionDivider label="3 projects" class="mt-2" />

  <div class="mt-10 space-y-6">
    <!-- X-Dispatch -->
    <a href="/projects/x-dispatch/" class="group block no-underline">
      <div
        class="overflow-hidden rounded-xl border border-border transition-colors group-hover:border-primary/30"
      >
        <div class="relative h-44 overflow-hidden sm:h-56">
          <Image
            src={xDispatchMap}
            alt="X-Dispatch world map showing airports"
            width={672}
            loading="eager"
            class="!m-0 size-full !rounded-none object-cover transition-transform duration-700 group-hover:scale-[1.03]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-card via-card/40 to-transparent"></div>
          <div class="absolute bottom-4 left-5 right-5 flex items-end justify-between">
            <div class="flex items-center gap-3">
              <Image
                src={xDispatchIcon}
                alt="X-Dispatch icon"
                width={40}
                height={40}
                loading="eager"
                class="!m-0 size-10 rounded-xl"
              />
              <div>
                <p
                  class="font-heading text-xl font-normal text-foreground transition-colors group-hover:text-primary sm:text-2xl"
                >
                  X-Dispatch
                </p>
                <p class="text-xs text-muted-foreground/80">Flight dispatch for X-Plane 12</p>
              </div>
            </div>
            <div class="hidden gap-2 sm:flex">
              <Badge variant="secondary" className="text-[0.6rem] font-normal backdrop-blur-sm">
                6k+ downloads
              </Badge>
            </div>
          </div>
        </div>
      </div>
    </a>

    <!-- AI Voice Agent + Dinar side by side -->
    <div class="grid gap-6 sm:grid-cols-2">
      <a href="/blog/ai-voice-agent-supervisor/" class="group block no-underline">
        <div
          class="overflow-hidden rounded-xl border border-border transition-colors group-hover:border-primary/30"
        >
          <div class="relative h-36 overflow-hidden sm:h-40">
            <img
              src="/images/ai-voice-agent-supervisor/room_view.webp"
              alt="AI Voice Agent supervisor dashboard"
              class="!m-0 size-full !rounded-none object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-card via-card/30 to-transparent">
            </div>
          </div>
          <div class="p-4">
            <p
              class="font-heading text-base font-normal text-foreground transition-colors group-hover:text-primary sm:text-lg"
            >
              AI Voice Agent
            </p>
            <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
              Real-time supervisor dashboard for AI phone calls.
            </p>
          </div>
        </div>
      </a>

      <a href="/projects/dinar-echange/" class="group block no-underline">
        <div
          class="overflow-hidden rounded-xl border border-border transition-colors group-hover:border-primary/30"
        >
          <div
            class="relative flex h-36 items-center justify-center overflow-hidden bg-card sm:h-40"
          >
            <img
              src="/images/projects/dinar-echange/screenshot-currencies.webp"
              alt="Dinar Échange currency rates screen"
              class="!m-0 h-full !rounded-none object-contain transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <p
              class="font-heading text-base font-normal text-foreground transition-colors group-hover:text-primary sm:text-lg"
            >
              Dinar Échange
            </p>
            <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
              Algerian dinar exchange rates. Because a friend asked.
            </p>
          </div>
        </div>
      </a>
    </div>
  </div>
</Base>
