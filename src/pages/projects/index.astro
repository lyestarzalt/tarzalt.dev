---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { Separator } from '@/components/ui/separator';
import { Badge } from '@/components/ui/badge';
import xDispatchIcon from '@/assets/projects/x-dispatch/icon.png';
---

<Base title="Projects - Lyes Tarzalt">
  <section class="pt-8">
    <h1 class="font-heading text-3xl font-bold tracking-tight">Projects</h1>
    <p class="mt-2 text-sm text-muted-foreground">Things I built because they needed to exist.</p>
  </section>

  <Separator className="my-8" />

  <div class="space-y-6">
    <a href="/projects/x-dispatch/" class="group block no-underline">
      <article>
        <div class="flex items-baseline justify-between gap-4">
          <h2
            class="font-heading text-lg font-semibold text-foreground transition-colors group-hover:text-primary"
          >
            X-Dispatch
          </h2>
          <span class="shrink-0 font-mono text-[0.6875rem] text-muted-foreground/50"
            >2,800+ downloads</span
          >
        </div>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Flight dispatch, airport visualization, and addon management for X-Plane 12. 3D globe with
          35,000+ airports.
        </p>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {
            ['Electron', 'React', 'TypeScript', 'MapLibre'].map((t) => (
              <Badge
                variant="secondary"
                className="text-[0.625rem] font-normal opacity-60 group-hover:opacity-100 transition-opacity"
              >
                {t}
              </Badge>
            ))
          }
        </div>
      </article>
      <Separator className="mt-6" />
    </a>

    <a href="/blog/ai-voice-agent-supervisor/" class="group block no-underline">
      <article>
        <div class="flex items-baseline justify-between gap-4">
          <h2
            class="font-heading text-lg font-semibold text-foreground transition-colors group-hover:text-primary"
          >
            AI Voice Agent Dashboard
          </h2>
        </div>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Real-time supervisor dashboard for AI phone calls. Sentiment analysis, live intervention,
          zero ghost calls.
        </p>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {
            ['LiveKit', 'Next.js', 'NestJS', 'Redis'].map((t) => (
              <Badge
                variant="secondary"
                className="text-[0.625rem] font-normal opacity-60 group-hover:opacity-100 transition-opacity"
              >
                {t}
              </Badge>
            ))
          }
        </div>
      </article>
      <Separator className="mt-6" />
    </a>

    <a href="/projects/dinar-echange/" class="group block no-underline">
      <article>
        <div class="flex items-baseline justify-between gap-4">
          <h2
            class="font-heading text-lg font-semibold text-foreground transition-colors group-hover:text-primary"
          >
            Dinar Échange
          </h2>
          <span class="shrink-0 font-mono text-[0.6875rem] text-muted-foreground/50"
            >Play Store</span
          >
        </div>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Algerian dinar exchange rates. Because a friend wanted it simple.
        </p>
      </article>
      <Separator className="mt-6" />
    </a>
  </div>
</Base>
