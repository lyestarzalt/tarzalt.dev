---
import Base from '@/layouts/Base.astro';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import { Card, CardContent } from '@/components/ui/card';
import { ScreenshotGallery } from '@/components/ScreenshotGallery';

const reviews = [
  { author: "Haui", text: "Hands down the best add-on for X-Plane! Period! I absolutely love the design and how fluid and quick to react this tool is.", helpful: "1 of 1" },
  { author: "DZ-Aviation", text: "X-Dispatch is the one stop tool that every simmer needs. I honestly thought Laminar would one day come up with something like this, but instead, you have taken the lead.", helpful: "2 of 2" },
  { author: "Encounia", text: "WOW. You should contact Laminar so they recruit you.", helpful: "1 of 1" },
  { author: "kemosabe", text: "Already shows great promise. The dev is very open to new ideas and looking for help to work out bugs. A big thank you for sharing this with the community.", helpful: "3 of 3" },
  { author: "ColinM9991", text: "This is a very sleek UI. Well done.", helpful: "2 of 2" },
  { author: "Suh", text: "Awesome application! Free and open source. Can't thank the creator enough.", helpful: "2 of 2" },
];

const techStack = [
  { layer: "Framework", tech: "Electron + React 18 + TypeScript" },
  { layer: "Build", tech: "Vite + Electron Forge" },
  { layer: "UI", tech: "Tailwind CSS + shadcn/ui" },
  { layer: "State", tech: "Zustand (persisted stores)" },
  { layer: "Data", tech: "TanStack Query + SQLite" },
  { layer: "Map", tech: "MapLibre GL JS" },
];
---

<Base
  title="X-Dispatch — Flight Dispatch for X-Plane 12"
  description="Desktop app for visualizing X-Plane airports, navigation data, and launching flights. 3D globe with 35,000+ airports. Free and open source."
>
  <!-- Hero -->
  <section class="py-12">
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <Badge variant="outline">Open Source</Badge>
      <Badge variant="secondary">Electron</Badge>
      <Badge variant="secondary">React</Badge>
      <Badge variant="secondary">TypeScript</Badge>
    </div>
    <h1 class="font-heading text-4xl font-bold italic tracking-tight md:text-5xl">X-Dispatch</h1>
    <p class="mt-2 text-lg text-muted-foreground">
      Flight dispatch, airport visualization, and addon management for X-Plane 12.
    </p>
    <p class="mt-4 max-w-lg text-sm leading-relaxed text-muted-foreground">
      X-Plane has detailed airport data but no global map to explore it. X-Dispatch gives you a 3D globe to browse, search, and discover 35,000+ airports. Click any airport to see runways, taxiways, gates, and markings. Import from SimBrief, configure your flight, and launch.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button asChild>
        <a href="https://github.com/lyestarzalt/x-dispatch/releases/latest" target="_blank" rel="noopener">
          Download
        </a>
      </Button>
      <Button variant="outline" asChild>
        <a href="https://github.com/lyestarzalt/x-dispatch" target="_blank" rel="noopener">
          GitHub
        </a>
      </Button>
      <Button variant="outline" asChild>
        <a href="https://discord.gg/7QBCNv8B" target="_blank" rel="noopener">
          Discord
        </a>
      </Button>
    </div>

    <div class="mt-6 flex gap-6 font-mono text-sm text-muted-foreground">
      <span><span class="text-primary">2,800+</span> downloads</span>
      <span><span class="text-primary">19</span> reviews</span>
      <span><span class="text-primary">39</span> stars</span>
      <span><span class="text-primary">10</span> languages</span>
    </div>
  </section>

  <!-- Hero screenshot -->
  <section class="overflow-hidden rounded-xl border border-border">
    <img src="/images/projects/x-dispatch-map.png" alt="X-Dispatch map overview" class="!m-0 w-full !rounded-none" loading="eager" />
  </section>

  <Separator className="my-10" />

  <!-- Screenshots gallery -->
  <section>
    <h2 class="mb-6 font-heading text-2xl font-semibold italic">Screenshots</h2>
    <ScreenshotGallery client:load />
  </section>

  <Separator className="my-10" />

  <!-- Features -->
  <section>
    <h2 class="mb-6 font-heading text-2xl font-semibold italic">Features</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <Card>
        <CardContent className="p-5">
          <h3 class="mb-2 font-heading text-sm font-semibold">Map & Visualization</h3>
          <ul class="space-y-1 text-xs leading-relaxed text-muted-foreground">
            <li>3D globe with terrain, hillshade, contour lines</li>
            <li>6 basemap styles</li>
            <li>35,000+ airports with custom scenery</li>
            <li>Weather radar overlay with playback</li>
            <li>Day/night terminator</li>
          </ul>
        </CardContent>
      </Card>
      <Card>
        <CardContent className="p-5">
          <h3 class="mb-2 font-heading text-sm font-semibold">Airport Details</h3>
          <ul class="space-y-1 text-xs leading-relaxed text-muted-foreground">
            <li>Runways, taxiways, aprons, gates</li>
            <li>Surface types, lighting, markings</li>
            <li>Parking positions with heading</li>
            <li>Helipads, windsocks, beacons</li>
          </ul>
        </CardContent>
      </Card>
      <Card>
        <CardContent className="p-5">
          <h3 class="mb-2 font-heading text-sm font-semibold">Navigation & Procedures</h3>
          <ul class="space-y-1 text-xs leading-relaxed text-muted-foreground">
            <li>VOR, NDB, DME, ILS with course viz</li>
            <li>SID, STAR, approach overlays</li>
            <li>Airspace boundaries and FIR</li>
            <li>Navigraph AIRAC support</li>
          </ul>
        </CardContent>
      </Card>
      <Card>
        <CardContent className="p-5">
          <h3 class="mb-2 font-heading text-sm font-semibold">Flight Launcher</h3>
          <ul class="space-y-1 text-xs leading-relaxed text-muted-foreground">
            <li>Aircraft browser with favorites</li>
            <li>Fuel, payload, weight & balance</li>
            <li>Gate, runway, helipad, or pin drop start</li>
            <li>Air start, carrier, frigate modes</li>
            <li>Cold & dark or engines running</li>
          </ul>
        </CardContent>
      </Card>
      <Card>
        <CardContent className="p-5">
          <h3 class="mb-2 font-heading text-sm font-semibold">SimBrief & Live Traffic</h3>
          <ul class="space-y-1 text-xs leading-relaxed text-muted-foreground">
            <li>One-click OFP import</li>
            <li>Route visualization on map</li>
            <li>VATSIM and IVAO overlays</li>
            <li>Live METAR with flight categories</li>
          </ul>
        </CardContent>
      </Card>
      <Card>
        <CardContent className="p-5">
          <h3 class="mb-2 font-heading text-sm font-semibold">Addon Manager</h3>
          <ul class="space-y-1 text-xs leading-relaxed text-muted-foreground">
            <li>Browse aircraft, plugins, liveries</li>
            <li>Drag-and-drop install (ZIP, RAR, 7z)</li>
            <li>Scenery priority management</li>
            <li>Multiple X-Plane installations</li>
          </ul>
        </CardContent>
      </Card>
    </div>
  </section>

  <Separator className="my-10" />

  <!-- Reviews -->
  <section>
    <h2 class="mb-2 font-heading text-2xl font-semibold italic">What people say</h2>
    <p class="mb-6 text-sm text-muted-foreground">
      From <a href="https://forums.x-plane.org/files/file/98500-x-dispatch/" target="_blank" rel="noopener" class="text-primary underline underline-offset-2 decoration-primary/30 hover:decoration-primary">X-Plane.Org</a> — 19 reviews, all 5 stars.
    </p>
    <div class="grid gap-3 sm:grid-cols-2">
      {reviews.map((review) => (
        <Card>
          <CardContent className="p-4">
            <p class="text-sm italic leading-relaxed text-muted-foreground">"{review.text}"</p>
            <div class="mt-3 flex items-center justify-between">
              <span class="text-xs font-medium text-foreground">{review.author}</span>
              <span class="font-mono text-[0.625rem] text-muted-foreground/50">{review.helpful} found helpful</span>
            </div>
          </CardContent>
        </Card>
      ))}
    </div>
  </section>

  <Separator className="my-10" />

  <!-- Tech stack -->
  <section>
    <h2 class="mb-6 font-heading text-2xl font-semibold italic">Tech stack</h2>
    <div class="overflow-hidden rounded-lg border border-border">
      <table class="!my-0 w-full">
        <tbody>
          {techStack.map((row, i) => (
            <tr class={i % 2 === 0 ? 'bg-card/50' : ''}>
              <td class="border-b border-border px-4 py-2.5 text-xs font-medium text-foreground">{row.layer}</td>
              <td class="border-b border-border px-4 py-2.5 font-mono text-xs text-muted-foreground">{row.tech}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <Separator className="my-10" />

  <!-- CTA -->
  <section class="py-6 text-center">
    <p class="text-sm text-muted-foreground">Free and open source. Windows, macOS, Linux.</p>
    <div class="mt-4 flex justify-center gap-3">
      <Button asChild>
        <a href="https://github.com/lyestarzalt/x-dispatch/releases/latest" target="_blank" rel="noopener">
          Download latest
        </a>
      </Button>
      <Button variant="outline" asChild>
        <a href="https://ko-fi.com/lyestarzalt" target="_blank" rel="noopener">
          Support on Ko-fi
        </a>
      </Button>
    </div>
  </section>
</Base>
