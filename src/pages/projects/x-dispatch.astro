---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { Badge } from '@/components/ui/badge';
import { Separator } from '@/components/ui/separator';
import LinkButton from '@/components/LinkButton.astro';
import { Card, CardContent } from '@/components/ui/card';
import { Gallery } from '@/components/Gallery';
import LinkPreview from '@/components/LinkPreview.astro';
import { AirportDiagram } from '@/components/AirportDiagram';
import PageHeader from '@/components/layout/PageHeader.astro';
import xDispatchIcon from '@/assets/projects/x-dispatch/icon.png';
---

<Base
  title="X-Dispatch — Flight Dispatch for X-Plane 12"
  description="Desktop app for visualizing X-Plane airports, navigation data, and launching flights. 3D globe with 35,000+ airports. Free and open source."
>
  <PageHeader
    title="X-Dispatch"
    subtitle="A free companion app for X-Plane 12. Browse airports on a 3D globe, set up your flight, and launch directly."
    layout="lockup"
  >
    <Image
      slot="media"
      src={xDispatchIcon}
      alt="X-Dispatch icon"
      width={80}
      height={80}
      loading="eager"
      class="!m-0 size-16 rounded-2xl sm:size-20"
    />

    <div slot="meta" class="flex flex-wrap gap-1.5">
      {
        ['Electron', 'React', 'TypeScript', 'MapLibre', 'Tailwind', 'SQLite'].map((t) => (
          <Badge variant="secondary" className="text-[0.6rem] font-normal">
            {t}
          </Badge>
        ))
      }
    </div>

    <div slot="actions" class="flex flex-wrap items-center gap-3">
      <LinkButton
        href="https://github.com/lyestarzalt/x-dispatch/releases/latest"
        target="_blank"
        rel="noopener">Download</LinkButton
      >
      <LinkButton
        variant="outline"
        href="https://github.com/lyestarzalt/x-dispatch"
        target="_blank"
        rel="noopener">GitHub</LinkButton
      >
      <LinkButton
        variant="outline"
        href="https://discord.gg/7QBCNv8B"
        target="_blank"
        rel="noopener">Discord</LinkButton
      >
      <LinkButton
        variant="outline"
        href="https://ko-fi.com/lyestarzalt"
        target="_blank"
        rel="noopener">Ko-fi</LinkButton
      >
    </div>

    <div
      slot="stats"
      class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-muted-foreground"
    >
      <span><span class="text-primary tabular-nums">14k+</span> downloads</span>
      <span><span class="text-primary tabular-nums">29</span> reviews</span>
      <span><span class="text-primary tabular-nums">10</span> languages</span>
    </div>
  </PageHeader>

  <!-- Interactive airport diagram — LFMN parsed from real apt.dat -->
  <section class="mb-12">
    <div class="mb-3 flex items-baseline justify-between">
      <p class="font-mono text-[0.625rem] uppercase tracking-[0.2em] text-muted-foreground/70">
        Live · LFMN Nice Côte d&rsquo;Azur
      </p>
      <p class="font-mono text-[0.625rem] text-muted-foreground/50">rendered in your browser</p>
    </div>
    <div
      class="relative aspect-[16/10] overflow-hidden rounded-2xl border border-border bg-card/40 sm:aspect-[16/9]"
    >
      <AirportDiagram client:visible variant="interactive" showCaption={false} />
    </div>
    <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
      LFMN parsed from X-Plane&rsquo;s <code class="font-mono text-[0.6875rem]">apt.dat</code>:
      runway geometry, taxiway pavement, painted markings, hold lines. Drag to pan, scroll to zoom.
    </p>
  </section>

  <!-- Screenshots -->
  <section>
    <Gallery
      client:load
      screenshots={[
        { src: '/images/projects/x-dispatch/x-dispatch-map.png', alt: 'World Map' },
        { src: '/images/projects/x-dispatch/x-dispatch-airport.png', alt: 'Airport Detail' },
        { src: '/images/projects/x-dispatch/x-dispatch-terrain.png', alt: '3D Terrain' },
        { src: '/images/projects/x-dispatch/x-dispatch-flight-setup.png', alt: 'Flight Setup' },
        { src: '/images/projects/x-dispatch/x-dispatch-procedures.png', alt: 'SID/STAR' },
        { src: '/images/projects/x-dispatch/x-dispatch-simbrief1.png', alt: 'SimBrief' },
        { src: '/images/projects/x-dispatch/x-dispatch-weather.png', alt: 'Weather' },
        { src: '/images/projects/x-dispatch/x-dispatch-tracking.png', alt: 'Live Tracking' },
        { src: '/images/projects/x-dispatch/x-dispatch-fuel.png', alt: 'Fuel & Payload' },
        { src: '/images/projects/x-dispatch/x-dispatch-starting.png', alt: 'Start Position' },
        { src: '/images/projects/x-dispatch/x-dispatch-addon1.png', alt: 'Addon Browser' },
      ]}
    />
  </section>

  <Separator className="my-12" />

  <!-- About the app -->
  <section class="space-y-5">
    <p class="text-sm leading-relaxed text-muted-foreground">
      Back in 2021, I asked Laminar Research if they had plans for a global airport map in X-Plane.
      They weren't interested. The idea stuck with me for years. I kept brainstorming how it would
      work, what it would look like, which problems I'd need to solve first.
    </p>
    <p class="text-sm leading-relaxed text-muted-foreground">
      The two hard parts were parsing X-Plane's airport data file (every smooth curve you see is a
      bezier encoded in a way that took me months to get right) and figuring out how to actually
      launch X-Plane with the user's choices (through an undocumented config file, and later an
      undocumented command line flag). I failed the first attempt with Flutter, shelved it, came
      back years later with MapLibre and Electron, and got it working.
    </p>
    <p class="text-sm leading-relaxed text-muted-foreground">
      X-Dispatch gives you a 3D globe with 35,000+ airports. Click any airport to see the full
      layout: runways, taxiways, gates, markings, all rendered from X-Plane's own data. Pick a
      starting position, choose your aircraft and livery, configure fuel and weather, hit launch. Or
      relocate mid-flight if the sim is already running.
    </p>
    <p class="text-sm leading-relaxed text-muted-foreground">
      Free and open source. Windows, macOS, Linux.
    </p>
    <div>
      <LinkButton size="sm" href="/blog/building-x-dispatch/">Read the full story</LinkButton>
    </div>
  </section>

  <Separator className="my-12" />

  <!-- Features -->
  <section>
    <h2 class="mb-6 font-heading text-xl font-semibold">Features</h2>
    <div class="space-y-6">
      <div>
        <h3 class="text-sm font-medium text-foreground">Map & airports</h3>
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
          3D globe with terrain elevation, hillshade, contour lines. 6 basemap styles. 35,000+
          airports with custom scenery detection. Day/night terminator. Weather radar overlay with
          playback. Range rings by aircraft category.
        </p>
      </div>
      <div>
        <h3 class="text-sm font-medium text-foreground">Airport detail</h3>
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
          Runways with surface types, dimensions, lighting, markings. Taxiways, aprons, pavement
          areas with signs. Gates and parking with heading indicators. Helipads, windsocks, beacons.
          All parsed from apt.dat.
        </p>
      </div>
      <div>
        <h3 class="text-sm font-medium text-foreground">Navigation</h3>
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
          VOR, NDB, DME, TACAN, ILS/LOC with course visualization. High and low altitude airways.
          Airspace boundaries and FIR regions. SID, STAR, approach procedures overlaid on the map.
          X-Plane native data or Navigraph with AIRAC detection.
        </p>
      </div>
      <div>
        <h3 class="text-sm font-medium text-foreground">Flight setup & launch</h3>
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
          Aircraft browser with search, filters, favorites. Livery selection remembered per
          aircraft. Fuel, payload, weight & balance. Start from any gate, runway, helipad, or custom
          pin drop. Air start, carrier catapult, frigate deck, glider tow. Weather presets or full
          custom. Direct X-Plane launch or mid-flight relocation via REST API.
        </p>
      </div>
      <div>
        <h3 class="text-sm font-medium text-foreground">SimBrief & live traffic</h3>
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
          One-click OFP import with route visualization. Fuel breakdown, weight summary, nav log.
          VATSIM and IVAO overlays with pilot callsigns. Live METAR with flight category display.
        </p>
      </div>
      <div>
        <h3 class="text-sm font-medium text-foreground">Addon manager & tracking</h3>
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
          Browse installed aircraft, plugins, liveries, Lua scripts. Drag-and-drop install from ZIP,
          RAR, 7z. Scenery priority management. Real-time flight tracking via WebSocket. Multiple
          X-Plane installations with quick switching.
        </p>
      </div>
    </div>
  </section>

  <Separator className="my-12" />

  <!-- Press -->
  <section>
    <h2 class="mb-4 font-heading text-xl font-semibold">Press</h2>
    <LinkPreview
      url="https://fselite.net/content/x-dispatch-adds-world-map-flight-launcher-and-add-on-manager-to-x-plane-12/"
    />
    <div class="mt-4">
      <LinkPreview url="https://www.youtube.com/watch?v=g4NxbxpyaQ8" />
    </div>
  </section>

  <Separator className="my-12" />

  <!-- Reviews -->
  <section>
    <h2 class="mb-2 font-heading text-xl font-semibold">Community</h2>
    <p class="mb-8 text-sm text-muted-foreground">
      This is genuinely heartwarming. I'm glad people find it useful.
    </p>

    <div class="space-y-5">
      <div class="border-l-2 border-primary/20 pl-4">
        <p class="text-sm leading-relaxed text-muted-foreground">
          "I no longer start X-Plane. I now start X-Dispatch."
        </p>
        <p class="mt-1.5 font-mono text-xs text-muted-foreground/40">Marespi</p>
      </div>
      <div class="border-l-2 border-primary/20 pl-4">
        <p class="text-sm leading-relaxed text-muted-foreground">
          "Hands down the best add-on for X-Plane! Period! I absolutely love the design and how
          fluid and quick to react this tool is. Oh boy, are the MSFS guys & gals gonna be jealous
          of this one."
        </p>
        <p class="mt-1.5 font-mono text-xs text-muted-foreground/40">Haui</p>
      </div>
      <div class="border-l-2 border-primary/20 pl-4">
        <p class="text-sm leading-relaxed text-muted-foreground">
          "X-Dispatch is the one stop tool that every simmer needs. I honestly thought Laminar would
          one day come up with something like this, but instead, you have taken the lead. I think
          Austin Meyer owes you a great one on this release."
        </p>
        <p class="mt-1.5 font-mono text-xs text-muted-foreground/40">DZ-Aviation</p>
      </div>
      <div class="border-l-2 border-primary/20 pl-4">
        <p class="text-sm leading-relaxed text-muted-foreground">
          "WOW. You should contact Laminar so they recruit you."
        </p>
        <p class="mt-1.5 font-mono text-xs text-muted-foreground/40">Encounia</p>
      </div>
      <div class="border-l-2 border-primary/20 pl-4">
        <p class="text-sm leading-relaxed text-muted-foreground">
          "Amazing utility app for X-Plane, I'm really enjoying the features, especially the 3D
          terrain viewer."
        </p>
        <p class="mt-1.5 font-mono text-xs text-muted-foreground/40">Sean McLeod</p>
      </div>
      <div class="border-l-2 border-primary/20 pl-4">
        <p class="text-sm leading-relaxed text-muted-foreground">"This is essential, thank you!"</p>
        <p class="mt-1.5 font-mono text-xs text-muted-foreground/40">Tenebrae Aeternae</p>
      </div>
      <div class="border-l-2 border-primary/20 pl-4">
        <p class="text-sm leading-relaxed text-muted-foreground">
          "Awesome application! Free and open source. Can't thank the creator enough."
        </p>
        <p class="mt-1.5 font-mono text-xs text-muted-foreground/40">Suh</p>
      </div>
      <div class="border-l-2 border-primary/20 pl-4">
        <p class="text-sm leading-relaxed text-muted-foreground">
          "This is a very sleek UI. Well done."
        </p>
        <p class="mt-1.5 font-mono text-xs text-muted-foreground/40">ColinM9991</p>
      </div>
      <div class="border-l-2 border-primary/20 pl-4">
        <p class="text-sm leading-relaxed text-muted-foreground">
          "This is a total game changer and I don't understand why Laminar has not come up with this
          in the last couple of years!"
        </p>
        <p class="mt-1.5 font-mono text-xs text-muted-foreground/40">luckythastriker</p>
      </div>
      <div class="border-l-2 border-primary/20 pl-4">
        <p class="text-sm leading-relaxed text-muted-foreground">
          "Best thing to happen to X-Plane since Map Enhancement!"
        </p>
        <p class="mt-1.5 font-mono text-xs text-muted-foreground/40">lantern53</p>
      </div>
      <div class="border-l-2 border-primary/20 pl-4">
        <p class="text-sm leading-relaxed text-muted-foreground">
          "Already shows great promise. The dev is very open to new ideas and looking for help to
          work out bugs. A big thank you for sharing this with the community."
        </p>
        <p class="mt-1.5 font-mono text-xs text-muted-foreground/40">kemosabe</p>
      </div>
    </div>

    <p class="mt-6 text-xs text-muted-foreground/50">
      <a
        href="https://forums.x-plane.org/files/file/98500-x-dispatch/"
        target="_blank"
        rel="noopener"
        class="text-primary underline underline-offset-2 decoration-primary/30 hover:decoration-primary"
        >All 29 reviews on X-Plane.Org</a
      >
    </p>
  </section>

  <Separator className="my-12" />

  <!-- Related posts -->
  <section>
    <h2 class="mb-4 font-heading text-xl font-semibold">Related posts</h2>
    <div class="flex flex-wrap gap-2">
      <LinkButton variant="outline" size="sm" href="/blog/building-x-dispatch/"
        >Building X-Dispatch</LinkButton
      >
      <LinkButton variant="outline" size="sm" href="/blog/parsing-xplane-airport-geometry/"
        >Parsing apt.dat geometry</LinkButton
      >
      <LinkButton variant="outline" size="sm" href="/blog/xplane-linear-features-line-types/"
        >Painted lines & taxiway lights</LinkButton
      >
    </div>
  </section>

  <Separator className="my-12" />

  <!-- CTA -->
  <section class="py-6">
    <p class="font-heading text-lg font-semibold">Free and open source.</p>
    <p class="mt-1 text-sm text-muted-foreground">Windows, macOS, Linux. Requires X-Plane 12.4+.</p>
    <div class="mt-5 flex flex-wrap gap-3">
      <LinkButton
        href="https://github.com/lyestarzalt/x-dispatch/releases/latest"
        target="_blank"
        rel="noopener">Download latest</LinkButton
      >
      <LinkButton
        variant="outline"
        href="https://ko-fi.com/lyestarzalt"
        target="_blank"
        rel="noopener">Support on Ko-fi</LinkButton
      >
    </div>
  </section>
</Base>
