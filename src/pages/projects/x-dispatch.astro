---
import Base from '@/layouts/Base.astro';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import { ScreenshotGallery } from '@/components/ScreenshotGallery';
import LinkPreview from '@/components/LinkPreview.astro';
---

<Base
  title="X-Dispatch — Flight Dispatch for X-Plane 12"
  description="Desktop app for visualizing X-Plane airports, navigation data, and launching flights. 3D globe with 35,000+ airports. Free and open source."
>
  <!-- Hero -->
  <section class="py-12">
    <div class="flex items-start gap-5">
      <img src="/images/projects/x-dispatch/icon.png" alt="X-Dispatch" class="!m-0 size-16 shrink-0 rounded-2xl sm:size-20" />
      <div>
        <h1 class="font-heading text-3xl font-bold italic tracking-tight sm:text-4xl">X-Dispatch</h1>
        <p class="mt-1 text-sm text-muted-foreground">
          Flight dispatch, airport visualization, and addon management for X-Plane 12.
        </p>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {["Electron", "React", "TypeScript", "MapLibre", "Tailwind", "SQLite"].map(t => (
            <Badge variant="secondary" className="text-[0.6rem] font-normal">{t}</Badge>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button asChild><a href="https://github.com/lyestarzalt/x-dispatch/releases/latest" target="_blank" rel="noopener">Download</a></Button>
      <Button variant="outline" asChild><a href="https://github.com/lyestarzalt/x-dispatch" target="_blank" rel="noopener">GitHub</a></Button>
      <Button variant="outline" asChild><a href="https://discord.gg/7QBCNv8B" target="_blank" rel="noopener">Discord</a></Button>
      <Button variant="outline" asChild><a href="https://ko-fi.com/lyestarzalt" target="_blank" rel="noopener">Ko-fi</a></Button>
    </div>

    <div class="mt-5 flex gap-6 font-mono text-xs text-muted-foreground">
      <span><span class="text-primary">2,800+</span> downloads</span>
      <span><span class="text-primary">19</span> reviews</span>
      <span><span class="text-primary">10</span> languages</span>
    </div>
  </section>

  <!-- Screenshots -->
  <section>
    <ScreenshotGallery client:load />
  </section>

  <Separator className="my-12" />

  <!-- Origin story -->
  <section>
    <h2 class="mb-4 font-heading text-xl font-semibold italic">The story</h2>
    <p class="text-sm leading-relaxed text-muted-foreground">
      In 2021, I asked Laminar Research if they'd build a global map. They weren't sold on it. So I built it myself.
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      <Button variant="outline" size="sm" asChild>
        <a href="/blog/building-x-dispatch/">Read the full story</a>
      </Button>
    </div>

    <LinkPreview url="https://fselite.net/content/x-dispatch-adds-world-map-flight-launcher-and-add-on-manager-to-x-plane-12/" />
  </section>

  <Separator className="my-12" />

  <!-- What it does — prose, not cards -->
  <section class="space-y-8">
    <h2 class="font-heading text-xl font-semibold italic">What it does</h2>

    <p class="text-sm leading-relaxed text-muted-foreground">
      X-Plane stores all airport data in a single text file called <code>apt.dat</code>. Every airport in the world, 35,000+ of them, with runways, taxiways, gates, markings, lights. X-Dispatch parses that file and renders it all on a 3D globe you can explore.
    </p>

    <p class="text-sm leading-relaxed text-muted-foreground">
      Click any airport. See the full layout: runways with surface types, taxiways with painted markings, gates with heading indicators. Browse SID/STAR/approach procedures overlaid on the map. Check VOR, NDB, ILS with course visualization. See airspace boundaries and FIR regions. Works with X-Plane's native nav data or Navigraph with AIRAC detection.
    </p>

    <p class="text-sm leading-relaxed text-muted-foreground">
      Import your flight plan from SimBrief with one click. Pick an aircraft (with search, filters, favorites). Choose a livery — remembered per aircraft. Set fuel, payload, weight & balance. Pick a starting position: any gate, runway, helipad, or drop a pin wherever you want. Configure weather and time. Hit launch. X-Plane opens with everything configured. Or if it's already running, relocate mid-flight via the REST API.
    </p>

    <p class="text-sm leading-relaxed text-muted-foreground">
      There's also VATSIM and IVAO live traffic overlays, real-time flight tracking via WebSocket, a weather radar with playback, an addon manager that handles ZIP/RAR/7z drag-and-drop installs, and scenery priority management. Available in 10 languages. Works on Windows, macOS, and Linux.
    </p>
  </section>

  <Separator className="my-12" />

  <!-- Reviews -->
  <section>
    <blockquote class="!my-0 !border-l-0 !bg-transparent !px-0 !py-0 !text-foreground not-italic">
      <p class="font-heading text-2xl font-semibold italic leading-snug text-foreground sm:text-3xl">
        "Hands down the best add-on for X-Plane. Period."
      </p>
      <footer class="mt-3 font-mono text-xs text-muted-foreground/50">— Haui, X-Plane.Org</footer>
    </blockquote>

    <div class="mt-10 space-y-6">
      <div>
        <p class="text-sm leading-relaxed text-muted-foreground">
          "I honestly thought Laminar would one day come up with something like this, but instead, you have taken the lead. I think Austin Meyer owes you a great one on this release."
        </p>
        <p class="mt-1 font-mono text-xs text-muted-foreground/40">— DZ-Aviation</p>
      </div>
      <div>
        <p class="text-sm leading-relaxed text-muted-foreground">
          "WOW. You should contact Laminar so they recruit you."
        </p>
        <p class="mt-1 font-mono text-xs text-muted-foreground/40">— Encounia</p>
      </div>
      <div>
        <p class="text-sm leading-relaxed text-muted-foreground">
          "Amazing utility app for X-Plane, I'm really enjoying the features, especially the 3D terrain viewer."
        </p>
        <p class="mt-1 font-mono text-xs text-muted-foreground/40">— Sean McLeod</p>
      </div>
      <div>
        <p class="text-sm leading-relaxed text-muted-foreground">
          "This is a very sleek UI. Well done."
        </p>
        <p class="mt-1 font-mono text-xs text-muted-foreground/40">— ColinM9991</p>
      </div>
    </div>

    <p class="mt-6 text-xs text-muted-foreground/50">
      <a href="https://forums.x-plane.org/files/file/98500-x-dispatch/" target="_blank" rel="noopener" class="text-primary underline underline-offset-2 decoration-primary/30 hover:decoration-primary">All 19 reviews on X-Plane.Org</a>
    </p>
  </section>

  <Separator className="my-12" />

  <!-- CTA -->
  <section class="py-6">
    <p class="font-heading text-lg font-semibold italic">Free and open source.</p>
    <p class="mt-1 text-sm text-muted-foreground">Windows, macOS, Linux. Requires X-Plane 12.4+.</p>
    <div class="mt-5 flex flex-wrap gap-3">
      <Button asChild><a href="https://github.com/lyestarzalt/x-dispatch/releases/latest" target="_blank" rel="noopener">Download latest</a></Button>
      <Button variant="outline" asChild><a href="https://ko-fi.com/lyestarzalt" target="_blank" rel="noopener">Support on Ko-fi</a></Button>
    </div>
  </section>
</Base>
