---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { Badge } from '@/components/ui/badge';
import { formatDate } from '@/lib/date';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

import { getCollection } from 'astro:content';
---

<Base title="Writing - Lyes Tarzalt">
  <section class="pt-12 sm:pt-16">
    <h1 class="font-heading text-4xl font-normal tracking-tight sm:text-5xl">Writing</h1>
    <p class="mt-3 text-sm text-muted-foreground">
      Engineering deep dives and things I figured out the hard way.
    </p>
  </section>

  <div class="mt-10 flex items-center gap-4">
    <div class="h-px flex-1 bg-border"></div>
    <span class="font-mono text-[0.5rem] uppercase tracking-[0.3em] text-muted-foreground/60">
      {posts.length} posts
    </span>
    <div class="h-px flex-1 bg-border"></div>
  </div>

  <div class="mt-10 space-y-6">
    {
      posts.map((post, i) => (
        <a href={`/blog/${post.id}/`} class="group block no-underline">
          <div class="overflow-hidden rounded-xl border border-border transition-colors group-hover:border-primary/30">
            {post.data.featuredImage && (
              <div class="relative h-36 overflow-hidden sm:h-44">
                <Image
                  src={post.data.featuredImage}
                  alt={post.data.title}
                  width={672}
                  class="!m-0 size-full !rounded-none object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-card via-card/30 to-transparent" />
              </div>
            )}
            <div class="p-5">
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="font-heading text-lg font-normal text-foreground transition-colors group-hover:text-primary sm:text-xl">
                  {post.data.title}
                </h2>
                <time
                  class="shrink-0 font-mono text-[0.625rem] text-muted-foreground/60"
                  datetime={post.data.date.toISOString()}
                >
                  {formatDate(post.data.date)}
                </time>
              </div>
              {post.data.description && (
                <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                  {post.data.description}
                </p>
              )}
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {post.data.tags.slice(0, 4).map((tag) => (
                    <Badge
                      variant="secondary"
                      className="text-[0.625rem] font-normal opacity-60 transition-opacity group-hover:opacity-100"
                    >
                      {tag}
                    </Badge>
                  ))}
                </div>
              )}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</Base>
