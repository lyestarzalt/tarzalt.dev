---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Badge } from '@/components/ui/badge';
import { Separator } from '@/components/ui/separator';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<Base title="Writing - Lyes Tarzalt">
  <section class="pt-8">
    <h1 class="font-heading text-3xl font-bold italic tracking-tight">Writing</h1>
    <p class="mt-2 text-sm text-muted-foreground">
      Engineering deep dives and things I figured out the hard way.
    </p>
  </section>

  <Separator className="my-8" />

  <div class="space-y-6">
    {posts.map((post) => (
      <a href={`/blog/${post.id}/`} class="group block no-underline">
        <article>
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-heading text-lg font-semibold text-foreground transition-colors group-hover:text-primary">
              {post.data.title}
            </h2>
            <time
              class="shrink-0 font-mono text-[0.6875rem] text-muted-foreground/50"
              datetime={post.data.date.toISOString()}
            >
              {formatDate(post.data.date)}
            </time>
          </div>
          {post.data.description && (
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              {post.data.description}
            </p>
          )}
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {post.data.tags.slice(0, 4).map((tag) => (
                <Badge variant="secondary" className="text-[0.625rem] font-normal opacity-60 group-hover:opacity-100 transition-opacity">
                  {tag}
                </Badge>
              ))}
            </div>
          )}
        </article>
        <Separator className="mt-6" />
      </a>
    ))}
  </div>
</Base>
