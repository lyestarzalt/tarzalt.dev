---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent } from '@/components/ui/card';
import { Separator } from '@/components/ui/separator';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}
---

<Base title="Writing - Lyes Tarzalt">
  <section class="mb-8">
    <h1 class="font-heading text-4xl font-bold tracking-tighter">Writing</h1>
    <p class="mt-2 text-base text-muted-foreground">Engineering deep dives, parsing adventures, and things I learned the hard way.</p>
  </section>

  <Separator className="mb-8" />

  <div class="space-y-4">
    {posts.map((post) => (
      <a href={`/blog/${post.id}/`} class="group block no-underline">
        <Card className="transition-colors hover:bg-accent/50">
          <CardContent className="p-5">
            <div class="flex items-start justify-between gap-4">
              <p class="text-base font-medium text-foreground transition-colors group-hover:text-primary">{post.data.title}</p>
              <time class="shrink-0 text-xs text-muted-foreground" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
            </div>
            {post.data.description && (
              <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{post.data.description}</p>
            )}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {post.data.tags.slice(0, 4).map((tag) => (
                  <Badge variant="secondary" className="text-[0.625rem] font-normal">{tag}</Badge>
                ))}
              </div>
            )}
          </CardContent>
        </Card>
      </a>
    ))}
  </div>
</Base>
