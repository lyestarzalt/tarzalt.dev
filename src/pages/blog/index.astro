---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}
---

<Base title="Writing - Lyes Tarzalt">
  <section class="blog-header">
    <h1>Writing</h1>
    <p class="blog-desc">Engineering deep dives, parsing adventures, and things I learned the hard way.</p>
  </section>

  <ul class="post-list">
    {posts.map((post, i) => (
      <li>
        <a href={`/blog/${post.id}/`} class="post-item">
          <div class="post-left">
            <span class="post-number">{String(i + 1).padStart(2, '0')}</span>
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
          </div>
          <div class="post-body">
            <span class="post-title">{post.data.title}</span>
            {post.data.description && (
              <p class="post-desc">{post.data.description}</p>
            )}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .blog-header {
    padding-bottom: 2.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .blog-header h1 {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    margin-bottom: 0.5rem;
  }

  .blog-desc {
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .post-list {
    list-style: none;
    padding: 0;
  }

  .post-list li {
    border-bottom: 1px solid var(--border-subtle);
  }

  .post-item {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 2rem;
    padding: 1.5rem 0;
    text-decoration: none;
    transition: all var(--transition);
    margin: 0 -0.75rem;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    border-radius: 4px;
  }

  .post-item:hover {
    background: var(--bg-elevated);
  }

  .post-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .post-number {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    opacity: 0.5;
  }

  time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .post-body {
    min-width: 0;
  }

  .post-title {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
    line-height: 1.4;
    display: block;
    transition: color var(--transition);
  }

  .post-item:hover .post-title {
    color: var(--accent);
  }

  .post-desc {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin-top: 0.5rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-tags {
    display: flex;
    gap: 0.375rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-tertiary);
    border: 1px solid var(--border);
    padding: 0.125rem 0.5rem;
    border-radius: 100px;
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .blog-header h1 { font-size: 2rem; }
    .post-item { grid-template-columns: 1fr; gap: 0.5rem; }
    .post-left { flex-direction: row; gap: 0.75rem; align-items: center; }
  }
</style>
