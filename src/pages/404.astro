---
import Base from '@/layouts/Base.astro';
import LinkButton from '@/components/LinkButton.astro';
---

<Base title="404 - Lyes Tarzalt">
  <section class="flex min-h-[50vh] flex-col items-center justify-center text-center">
    <p class="font-mono text-7xl font-normal text-primary/20">404</p>
    <h1 class="mt-4 font-heading text-2xl font-normal">Not here</h1>
    <p class="mt-3 max-w-xs text-sm text-muted-foreground">
      This page doesn't exist. Maybe it did once. Maybe it never did. Either way, not your fault.
    </p>
    <div class="mt-8 flex gap-3">
      <LinkButton variant="outline" size="sm" href="/">Go home</LinkButton>
      <LinkButton variant="outline" size="sm" href="/blog/">Read something</LinkButton>
    </div>
  </section>
</Base>
