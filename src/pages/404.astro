---
import Base from '@/layouts/Base.astro';
import LinkButton from '@/components/LinkButton.astro';
---

<Base title="404 - Lyes Tarzalt">
  <section class="flex min-h-[50vh] flex-col items-center justify-center text-center">
    <p class="font-mono text-6xl font-bold text-primary/30">404</p>
    <h1 class="mt-4 font-heading text-2xl font-semibold">Not here</h1>
    <p class="mt-2 text-sm text-muted-foreground">Whatever you were looking for, it's not at this URL.</p>
    <div class="mt-6 flex gap-3">
      <LinkButton variant="outline" size="sm" href="/">Go home</LinkButton>
      <LinkButton variant="outline" size="sm" href="/blog/">Read something</LinkButton>
    </div>
  </section>
</Base>
