---
import Base from '@/layouts/Base.astro';
import { Button } from '@/components/ui/button';
---

<Base title="404 - Lyes Tarzalt">
  <section class="flex min-h-[50vh] flex-col items-center justify-center text-center">
    <p class="font-mono text-6xl font-bold text-primary/30">404</p>
    <h1 class="mt-4 font-heading text-2xl font-semibold italic">Not here</h1>
    <p class="mt-2 text-sm text-muted-foreground">Whatever you were looking for, it's not at this URL.</p>
    <div class="mt-6 flex gap-3">
      <Button variant="outline" size="sm" asChild>
        <a href="/">Go home</a>
      </Button>
      <Button variant="outline" size="sm" asChild>
        <a href="/blog/">Read something</a>
      </Button>
    </div>
  </section>
</Base>
