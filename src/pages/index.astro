---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}
---

<Base title="Lyes Tarzalt">
  <section class="hero">
    <div class="hero-label">Software Engineer</div>
    <h1>Lyes<br/>Tarzalt</h1>
    <p class="hero-bio">
      I build things that work. Based in Malaysia, originally from Algeria.
      I write about parsing, flight simulation tools, and the engineering behind real-time systems.
    </p>
    <div class="hero-links">
      <a href="https://github.com/lyestarzalt" target="_blank" rel="noopener">GitHub</a>
      <a href="https://linkedin.com/in/lyes-tarzalt" target="_blank" rel="noopener">LinkedIn</a>
      <a href="mailto:lyes.trzlt@gmail.com">Email</a>
    </div>
  </section>

  <section class="posts">
    <div class="section-header">
      <h2>Writing</h2>
      <a href="/blog/" class="view-all">View all</a>
    </div>
    <ul class="post-list">
      {posts.map((post, i) => (
        <li>
          <a href={`/blog/${post.id}/`} class="post-item">
            <div class="post-number">{String(i + 1).padStart(2, '0')}</div>
            <div class="post-content">
              <span class="post-title">{post.data.title}</span>
              {post.data.summary && (
                <p class="post-summary">{post.data.summary}</p>
              )}
            </div>
            <time class="post-date" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    padding: 3rem 0 4rem;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .hero h1 {
    font-family: var(--font-heading);
    font-size: 3.5rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  .hero-bio {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 32rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .hero-links {
    display: flex;
    gap: 1.5rem;
  }

  .hero-links a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color var(--transition);
    position: relative;
  }

  .hero-links a::before {
    content: '~';
    margin-right: 0.25rem;
    color: var(--text-tertiary);
    opacity: 0.4;
  }

  .hero-links a:hover {
    color: var(--accent);
  }

  /* ── Posts section ── */
  .posts {
    padding: 2rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
  }

  .section-header h2 {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .view-all {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color var(--transition);
  }

  .view-all:hover {
    color: var(--accent);
  }

  .post-list {
    list-style: none;
    padding: 0;
  }

  .post-list li {
    border-top: 1px solid var(--border-subtle);
  }

  .post-list li:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }

  .post-item {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    gap: 1.25rem;
    align-items: start;
    padding: 1.25rem 0;
    text-decoration: none;
    transition: background var(--transition);
    border-radius: 0;
    margin: 0 -0.75rem;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }

  .post-item:hover {
    background: var(--bg-elevated);
  }

  .post-number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    padding-top: 0.1875rem;
  }

  .post-content {
    min-width: 0;
  }

  .post-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
    line-height: 1.4;
    display: block;
    transition: color var(--transition);
  }

  .post-item:hover .post-title {
    color: var(--accent);
  }

  .post-summary {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin-top: 0.375rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    padding-top: 0.1875rem;
  }

  @media (max-width: 640px) {
    .hero h1 { font-size: 2.5rem; }
    .hero { padding: 2rem 0 3rem; }
    .post-item { grid-template-columns: 1fr auto; }
    .post-number { display: none; }
    .post-summary { display: none; }
  }
</style>
