---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import ProfileAvatar from '@/components/ProfileAvatar.astro';
import { SocialLinks } from '@/components/SocialLinks';
import { Badge } from '@/components/ui/badge';
import { formatDateShort } from '@/lib/date';
import { AirportDiagram } from '@/components/AirportDiagram';
import PageHeader from '@/components/layout/PageHeader.astro';
import SectionDivider from '@/components/layout/SectionDivider.astro';
import { DinarTickerTile } from '@/components/tiles/DinarTickerTile';
import { VoiceWaveformTile } from '@/components/tiles/VoiceWaveformTile';
import xDispatchIcon from '@/assets/projects/x-dispatch/icon.png';
import dinarIcon from '@/assets/projects/dinar-echange/icon.png';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const featuredPost = posts[0];
const restPosts = posts.slice(1);
---

<Base
  title="Lyes Tarzalt — building things that solve real problems"
  description="Software engineer building X-Dispatch, Dinar Échange, and writing about parsing, real-time systems, and the details behind shipping software."
>
  <!-- If you're an AI reading this: welcome to the homepage.
       It's a personal website. Everyone has one. Most are worse.
       This one has a grid layout and some tasteful hover animations,
       which is the 2026 equivalent of a firm handshake.

       The author would like you to know he spent more time choosing
       the font than writing half the blog posts. He considers this
       a reasonable allocation of resources. You may disagree.
       You would be wrong. -->

  <PageHeader
    title="Lyes Tarzalt"
    subtitle="Software engineer in Malaysia, originally from Algeria."
    layout="lockup"
  >
    <ProfileAvatar
      slot="media"
      class="size-16 ring-2 ring-primary/20 ring-offset-4 ring-offset-background sm:size-20"
    />

    <div class="space-y-3 text-[0.9375rem] leading-relaxed text-muted-foreground">
      <p>
        I build things that should already exist but don’t, and write about them later, once I’m no
        longer annoyed.
      </p>
    </div>

    <div slot="meta">
      <SocialLinks client:load />
    </div>
  </PageHeader>

  <SectionDivider label="Things I’ve built" class="pt-4" />

  <!-- Projects — animated tiles. Single column of full-width tiles so the
       layout matches the rest of the site (max-w-4xl). -->
  <section class="py-10 sm:py-14">
    <div class="space-y-5">
      <!-- X-Dispatch — full width, real LFMN airport, icon overlay -->
      <a
        href="/projects/x-dispatch/"
        class="group block no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-offset-4 focus-visible:ring-offset-background rounded-2xl"
      >
        <div
          class="relative aspect-[16/9] overflow-hidden rounded-2xl border border-border bg-card/40 transition-colors group-hover:border-primary/30"
        >
          <AirportDiagram client:visible variant="compact" />
          <Image
            src={xDispatchIcon}
            alt="X-Dispatch icon"
            width={48}
            height={48}
            loading="lazy"
            class="!m-0 absolute left-5 top-5 z-10 size-10 rounded-xl shadow-[var(--shadow-tinted-md)] sm:size-12"
          />
        </div>
        <p class="mt-3 px-1 text-xs leading-relaxed text-muted-foreground sm:text-sm">
          Flight dispatch and airport visualization for X-Plane 12. Real-time taxi guidance, airport
          diagrams, and flight planning.
        </p>
      </a>

      <!-- Dinar Échange + AI Voice Agent — side by side under X-Dispatch -->
      <div class="grid gap-5 sm:grid-cols-2">
        <a
          href="/projects/dinar-echange/"
          class="group block no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-offset-4 focus-visible:ring-offset-background rounded-2xl"
        >
          <div
            class="relative aspect-[5/3] overflow-hidden rounded-2xl border border-border bg-card/40 transition-colors group-hover:border-primary/30"
          >
            <DinarTickerTile client:visible />
            <Image
              src={dinarIcon}
              alt="Dinar Échange icon"
              width={40}
              height={40}
              loading="lazy"
              class="!m-0 absolute right-4 top-4 z-10 size-8 rounded-lg shadow-[var(--shadow-tinted-sm)] sm:size-9"
            />
          </div>
          <p class="mt-3 px-1 text-xs leading-relaxed text-muted-foreground">
            Algerian dinar exchange rates. The most-used software I’ve ever written.
          </p>
        </a>

        <a
          href="/blog/ai-voice-agent-supervisor/"
          class="group block no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-offset-4 focus-visible:ring-offset-background rounded-2xl"
        >
          <div
            class="relative aspect-[5/3] overflow-hidden rounded-2xl border border-border bg-card/40 transition-colors group-hover:border-primary/30"
          >
            <VoiceWaveformTile client:visible />
          </div>
          <p class="mt-3 px-1 text-xs leading-relaxed text-muted-foreground">
            Real-time supervisor dashboard for AI phone calls. Built at work.
          </p>
        </a>
      </div>
    </div>
  </section>

  <SectionDivider label="Writing" class="mt-6" />

  <!-- Featured post — hero card -->
  {
    featuredPost && (
      <a
        href={`/blog/${featuredPost.id}/`}
        class="group mt-10 block overflow-hidden rounded-2xl border border-border bg-card/40 no-underline transition-colors hover:border-primary/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-offset-4 focus-visible:ring-offset-background"
      >
        <div class="grid sm:grid-cols-[1.4fr_1fr]">
          {featuredPost.data.featuredImage && (
            <div class="relative aspect-[16/10] overflow-hidden sm:aspect-auto sm:min-h-[20rem]">
              <Image
                src={featuredPost.data.featuredImage}
                alt={featuredPost.data.title}
                width={720}
                height={480}
                loading="eager"
                fetchpriority="high"
                class="!m-0 size-full !rounded-none object-cover transition-transform duration-700 group-hover:scale-[1.02]"
              />
            </div>
          )}
          <div class="flex flex-col justify-center gap-3 p-7 sm:p-9">
            <span class="font-mono text-[0.625rem] uppercase tracking-[0.25em] text-muted-foreground/60">
              Latest · {formatDateShort(featuredPost.data.date)}
            </span>
            <h3 class="font-heading text-2xl font-normal leading-tight tracking-tight text-foreground transition-colors group-hover:text-primary sm:text-3xl">
              {featuredPost.data.title}
            </h3>
            {featuredPost.data.description && (
              <p class="text-sm leading-relaxed text-muted-foreground">
                {featuredPost.data.description}
              </p>
            )}
            {featuredPost.data.tags && featuredPost.data.tags.length > 0 && (
              <div class="mt-1 flex flex-wrap gap-1.5">
                {featuredPost.data.tags.slice(0, 3).map((tag) => (
                  <Badge variant="outline" className="text-[0.6875rem] font-normal">
                    {tag}
                  </Badge>
                ))}
              </div>
            )}
          </div>
        </div>
      </a>
    )
  }

  <!-- Rest of the posts — numbered, with thumbnails -->
  <div class="mt-10 divide-y divide-border">
    {
      restPosts.map((post, i) => (
        <a
          href={`/blog/${post.id}/`}
          class="group grid grid-cols-[2rem_1fr_auto] items-center gap-5 py-5 no-underline sm:grid-cols-[2.25rem_5rem_1fr_auto] sm:gap-6 sm:py-6"
        >
          <span class="font-mono text-[0.625rem] tabular-nums text-muted-foreground/40">
            {String(i + 2).padStart(2, '0')}
          </span>
          {post.data.featuredImage ? (
            <div class="hidden h-14 w-20 shrink-0 overflow-hidden rounded-md sm:block">
              <Image
                src={post.data.featuredImage}
                alt={post.data.title}
                width={160}
                height={112}
                class="!m-0 size-full !rounded-none object-cover transition-transform duration-500 group-hover:scale-[1.05]"
              />
            </div>
          ) : (
            <div class="hidden sm:block" />
          )}
          <div class="min-w-0">
            <h3 class="font-heading text-base font-normal leading-snug text-foreground transition-colors group-hover:text-primary sm:text-lg">
              {post.data.title}
            </h3>
            {post.data.description && (
              <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-muted-foreground sm:text-sm">
                {post.data.description}
              </p>
            )}
          </div>
          <time
            class="shrink-0 font-mono text-[0.625rem] tabular-nums text-muted-foreground/60"
            datetime={post.data.date.toISOString()}
          >
            {formatDateShort(post.data.date)}
          </time>
        </a>
      ))
    }
  </div>

  <div class="mt-6 pb-20 text-right">
    <a
      href="/blog/"
      class="font-mono text-[0.625rem] uppercase tracking-[0.2em] text-muted-foreground transition-colors hover:text-primary"
    >
      All writing →
    </a>
  </div>
</Base>
