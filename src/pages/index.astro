---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Separator } from '@/components/ui/separator';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Card, CardContent } from '@/components/ui/card';
import ProfileAvatar from '@/components/ProfileAvatar.astro';
import { SocialLinks } from '@/components/SocialLinks';
import xDispatchMap from '@/assets/projects/x-dispatch/map.png';
import xDispatchIcon from '@/assets/projects/x-dispatch/icon.png';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}
---

<Base title="Lyes Tarzalt">
  <!-- Hero -->
  <section class="flex flex-col gap-6 py-12 sm:flex-row sm:items-center sm:gap-8">
    <ProfileAvatar class="size-20 shrink-0 ring-2 ring-primary/20 ring-offset-2 ring-offset-background sm:size-24" />
    <div>
      <h1 class="font-heading text-3xl font-bold italic tracking-tight sm:text-4xl">Lyes Tarzalt</h1>
      <p class="mt-1 font-mono text-xs uppercase tracking-widest text-primary">Product Engineer</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted-foreground">
        I build things that help people. When I see a problem, I want to understand why it exists before I start writing code.
      </p>
      <div class="mt-4">
        <SocialLinks client:load />
      </div>
    </div>
  </section>

  <Separator />

  <!-- Projects -->
  <section class="py-10">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Projects</h2>
    </div>

    <!-- X-Dispatch -->
    <a href="/projects/x-dispatch/" class="group block no-underline">
      <Card className="overflow-hidden transition-colors hover:border-primary/30">
        <CardContent className="p-0">
          <div class="relative h-40 overflow-hidden sm:h-48">
            <Image
              src={xDispatchMap}
              alt="X-Dispatch world map showing airports"
              width={672}
              loading="eager"
              class="!m-0 size-full !rounded-none object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-card via-transparent to-transparent" />
          </div>
          <div class="p-5">
            <div class="flex items-center gap-3">
              <Image src={xDispatchIcon} alt="X-Dispatch icon" width={32} height={32} loading="eager" class="!m-0 size-8 rounded-lg" />
              <div>
                <p class="font-heading text-base font-semibold text-foreground transition-colors group-hover:text-primary">X-Dispatch</p>
                <p class="text-xs text-muted-foreground">Flight dispatch for X-Plane 12</p>
              </div>
              <div class="ml-auto hidden gap-2 sm:flex">
                <Badge variant="secondary" className="text-[0.6rem] font-normal">2,800+ downloads</Badge>
                <Badge variant="secondary" className="text-[0.6rem] font-normal">19 reviews</Badge>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>
    </a>

    <!-- Other projects row -->
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <a href="/blog/ai-voice-agent-supervisor/" class="group block no-underline">
        <Card className="h-full transition-colors hover:border-primary/30">
          <CardContent className="p-5">
            <p class="font-heading text-sm font-semibold text-foreground transition-colors group-hover:text-primary">AI Voice Agent</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Real-time supervisor dashboard for AI phone calls. Sentiment analysis, live intervention.
            </p>
          </CardContent>
        </Card>
      </a>
      <a href="https://play.google.com/store/apps/details?id=com.dinarexchange.app" target="_blank" rel="noopener" class="group block no-underline">
        <Card className="h-full transition-colors hover:border-primary/30">
          <CardContent className="p-5">
            <p class="font-heading text-sm font-semibold text-foreground transition-colors group-hover:text-primary">Dinar Échange</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Algerian dinar exchange rates. Because a friend wanted it simple.
            </p>
          </CardContent>
        </Card>
      </a>
    </div>
  </section>

  <Separator />

  <!-- Writing -->
  <section class="py-10">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Writing</h2>
      <a href="/blog/" class="font-mono text-xs text-muted-foreground no-underline transition-colors hover:text-primary">all posts &rarr;</a>
    </div>

    <div class="space-y-1">
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="group -mx-3 flex items-center gap-4 rounded-lg px-3 py-3 no-underline transition-colors hover:bg-card">
          {post.data.featuredImage && (
            <div class="hidden shrink-0 overflow-hidden rounded-md sm:block">
              <Image
                src={post.data.featuredImage}
                alt={post.data.title}
                width={64}
                height={44}
                class="!m-0 !rounded-none object-cover"
                style="width: 64px; height: 44px;"
              />
            </div>
          )}
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-foreground transition-colors group-hover:text-primary">{post.data.title}</p>
            <p class="mt-0.5 font-mono text-[0.6875rem] text-muted-foreground/50">{formatDate(post.data.date)}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
