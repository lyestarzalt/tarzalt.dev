---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Separator } from '@/components/ui/separator';
import { Badge } from '@/components/ui/badge';
import { AspectRatio } from '@/components/ui/aspect-ratio';
import ProfileAvatar from '@/components/ProfileAvatar.astro';
import { SocialLinks } from '@/components/SocialLinks';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}

const [featured, ...rest] = posts;
---

<Base title="Lyes Tarzalt">
  <!-- Hero — compact, horizontal -->
  <section class="flex flex-col gap-6 py-12 sm:flex-row sm:items-center sm:gap-8">
    <ProfileAvatar class="size-20 shrink-0 ring-2 ring-primary/20 ring-offset-2 ring-offset-background sm:size-24" />
    <div>
      <h1 class="font-heading text-3xl font-bold italic tracking-tight sm:text-4xl">
        Lyes Tarzalt
      </h1>
      <p class="mt-1 font-mono text-xs uppercase tracking-widest text-primary">Product Engineer</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted-foreground">
        I build things that help people. When I see a problem, I want to understand why it exists before I start writing code.
      </p>
      <div class="mt-4">
        <SocialLinks client:load />
      </div>
    </div>
  </section>

  <!-- Projects — bento grid -->
  <section class="py-8">
    <h2 class="mb-6 font-mono text-xs uppercase tracking-widest text-muted-foreground">What I've built</h2>
    <div class="bento-grid">
      <!-- X-Dispatch — large tile with screenshot -->
      <a href="/projects/x-dispatch/"
        class="bento-tile bento-large group no-underline">
        <div class="absolute inset-0 overflow-hidden">
          <img src="/images/projects/x-dispatch/x-dispatch-terrain.png" alt="" class="!m-0 size-full !rounded-none object-cover opacity-20 transition-opacity duration-500 group-hover:opacity-30" />
          <div class="absolute inset-0 bg-gradient-to-t from-card via-card/90 to-transparent"></div>
        </div>
        <div class="relative z-10 flex h-full flex-col justify-end p-5">
          <div class="mb-3 flex items-center gap-2">
            <span class="font-heading text-lg font-semibold text-foreground">X-Dispatch</span>
            <Badge variant="outline" className="text-[0.6rem]">Open Source</Badge>
          </div>
          <p class="max-w-xs text-sm leading-relaxed text-muted-foreground">
            Flight dispatch for X-Plane 12. 3D globe, 35,000+ airports, flight setup, addon manager.
          </p>
          <p class="mt-3 border-l-2 border-primary/30 pl-3 text-xs italic text-muted-foreground/70">
            "Hands down the best add-on for X-Plane. Period."
          </p>
          <div class="mt-3 flex items-center gap-4 font-mono text-xs text-muted-foreground/60">
            <span class="text-primary transition-colors group-hover:text-foreground">2,800+ downloads</span>
            <span>19 reviews</span>
            <span class="ml-auto transition-colors group-hover:text-primary">&rarr;</span>
          </div>
        </div>
      </a>

      <!-- Voice Agent — medium tile -->
      <a href="/blog/ai-voice-agent-supervisor/" class="bento-tile bento-medium group no-underline">
        <div class="relative z-10 flex h-full flex-col justify-between p-5">
          <div>
            <span class="font-heading text-base font-semibold text-foreground">AI Voice Agent</span>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              Real-time supervisor dashboard for AI phone calls. Sentiment bubbles, live intervention, zero ghost calls.
            </p>
          </div>
          <div class="mt-3 font-mono text-xs text-muted-foreground/60">
            <span class="transition-colors group-hover:text-primary">read the story &rarr;</span>
          </div>
        </div>
      </a>

      <!-- Dinar Échange — small tile -->
      <a href="https://play.google.com/store/apps/details?id=com.dinarexchange.app" target="_blank" rel="noopener"
        class="bento-tile bento-small group no-underline">
        <div class="relative z-10 flex h-full flex-col justify-between p-5">
          <div>
            <span class="font-heading text-base font-semibold text-foreground">Dinar Échange</span>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
              Algerian dinar exchange rates. Because a friend wanted it simple.
            </p>
          </div>
          <div class="mt-2 font-mono text-xs text-muted-foreground/60">
            <span class="transition-colors group-hover:text-primary">Play Store &rarr;</span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <Separator />

  <!-- Writing -->
  <section class="py-10">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Writing</h2>
      <a href="/blog/" class="font-mono text-xs text-muted-foreground no-underline transition-colors hover:text-primary">
        all posts &rarr;
      </a>
    </div>

    <div class="space-y-1">
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="group -mx-3 flex items-center gap-4 rounded-lg px-3 py-3 no-underline transition-colors hover:bg-card">
          {post.data.featuredImage && (
            <div class="hidden shrink-0 overflow-hidden rounded-md sm:block">
              <Image
                src={post.data.featuredImage}
                alt={post.data.title}
                width={64}
                height={44}
                class="!m-0 !rounded-none object-cover transition-transform duration-300 group-hover:scale-105"
                style="width: 64px; height: 44px;"
              />
            </div>
          )}
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-foreground transition-colors group-hover:text-primary">
              {post.data.title}
            </p>
            <p class="mt-0.5 font-mono text-[0.6875rem] text-muted-foreground/50">
              {formatDate(post.data.date)}
            </p>
          </div>
          <svg class="size-4 shrink-0 text-muted-foreground/20 transition-colors group-hover:text-primary" viewBox="0 0 16 16" fill="none">
            <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  @reference "@/styles/global.css";

  /* Bento grid */
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 0.75rem;
  }

  .bento-large {
    grid-column: 1 / -1;
  }

  @media (min-width: 640px) {
    .bento-grid {
      grid-template-columns: 1.4fr 1fr;
      grid-template-rows: auto auto;
    }
    .bento-large {
      grid-column: 1 / 2;
      grid-row: 1 / 3;
    }
    .bento-medium {
      grid-column: 2 / 3;
      grid-row: 1 / 2;
    }
  }

  /* Tiles */
  .bento-tile {
    @apply relative overflow-hidden rounded-xl border border-border bg-card transition-all;
    min-height: 120px;
  }

  a.bento-tile:hover {
    @apply border-primary/30;
    box-shadow: 0 0 24px -8px oklch(var(--primary) / 0.15);
  }

  /* Subtle grid pattern on the large tile */
  .bento-bg-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image:
      linear-gradient(oklch(var(--foreground)) 1px, transparent 1px),
      linear-gradient(90deg, oklch(var(--foreground)) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }

  /* Staggered fade-in */
  .bento-tile {
    animation: bento-in 0.5s ease-out both;
  }
  .bento-tile:nth-child(1) { animation-delay: 0.1s; }
  .bento-tile:nth-child(2) { animation-delay: 0.2s; }
  .bento-tile:nth-child(3) { animation-delay: 0.3s; }
  .bento-tile:nth-child(4) { animation-delay: 0.35s; }

  @keyframes bento-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
