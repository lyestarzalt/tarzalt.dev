---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Badge } from '@/components/ui/badge';
import LinkButton from '@/components/LinkButton.astro';
import ProfileAvatar from '@/components/ProfileAvatar.astro';
import { SocialLinks } from '@/components/SocialLinks';
import xDispatchMap from '@/assets/projects/x-dispatch/map.png';
import xDispatchIcon from '@/assets/projects/x-dispatch/icon.png';
import { formatDateShort } from '@/lib/date';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Lyes Tarzalt — building things that solve real problems">
  <!-- Hero -->
  <section class="pt-16 pb-12 sm:pt-24 sm:pb-16">
    <div class="flex items-center gap-5 sm:gap-6">
      <ProfileAvatar
        class="size-14 shrink-0 ring-2 ring-primary/20 ring-offset-2 ring-offset-background sm:size-16"
      />
      <div>
        <h1 class="font-heading text-4xl font-normal tracking-tight sm:text-5xl md:text-6xl">
          Lyes Tarzalt
        </h1>
        <p class="mt-1 text-sm text-muted-foreground">I build things, break things, ship things.</p>
      </div>
    </div>

    <div class="mt-6">
      <SocialLinks client:load />
    </div>
  </section>

  <!-- Divider -->
  <div class="flex items-center gap-4">
    <div class="h-px flex-1 bg-border"></div>
    <h2 class="font-mono text-[0.5rem] uppercase tracking-[0.3em] text-muted-foreground/40">
      Projects
    </h2>
    <div class="h-px flex-1 bg-border"></div>
  </div>

  <!-- Projects -->
  <section class="py-12 sm:py-16">
    <!-- X-Dispatch — Featured -->
    <a href="/projects/x-dispatch/" class="group block no-underline">
      <div
        class="relative overflow-hidden rounded-xl border border-border transition-colors group-hover:border-primary/30"
      >
        <div class="relative h-44 overflow-hidden sm:h-56">
          <Image
            src={xDispatchMap}
            alt="X-Dispatch world map showing airports"
            width={672}
            loading="eager"
            class="!m-0 size-full !rounded-none object-cover transition-transform duration-700 group-hover:scale-[1.03]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-card via-card/40 to-transparent"></div>
          <div class="absolute bottom-4 left-5 right-5 flex items-end justify-between">
            <div class="flex items-center gap-3">
              <Image
                src={xDispatchIcon}
                alt="X-Dispatch icon"
                width={40}
                height={40}
                loading="eager"
                class="!m-0 size-10 rounded-xl"
              />
              <div>
                <p
                  class="font-heading text-xl font-normal text-foreground transition-colors group-hover:text-primary sm:text-2xl"
                >
                  X-Dispatch
                </p>
                <p class="text-xs text-muted-foreground/80">Flight dispatch for X-Plane 12</p>
              </div>
            </div>
            <div class="hidden gap-2 sm:flex">
              <Badge variant="secondary" className="text-[0.6rem] font-normal backdrop-blur-sm">
                2,800+ downloads
              </Badge>
            </div>
          </div>
        </div>
      </div>
    </a>

    <!-- Two projects with screenshots -->
    <div class="mt-5 grid gap-5 sm:grid-cols-2">
      <!-- AI Voice Agent -->
      <a href="/blog/ai-voice-agent-supervisor/" class="group block no-underline">
        <div
          class="overflow-hidden rounded-xl border border-border transition-colors group-hover:border-primary/30"
        >
          <div class="relative h-36 overflow-hidden sm:h-40">
            <img
              src="/images/ai-voice-agent-supervisor/room_view.png"
              alt="AI Voice Agent supervisor dashboard"
              class="!m-0 size-full !rounded-none object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-card via-card/30 to-transparent">
            </div>
          </div>
          <div class="p-4">
            <p
              class="font-heading text-base font-normal text-foreground transition-colors group-hover:text-primary sm:text-lg"
            >
              AI Voice Agent
            </p>
            <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
              Real-time supervisor dashboard for AI phone calls.
            </p>
          </div>
        </div>
      </a>

      <!-- Dinar Échange -->
      <a href="/projects/dinar-echange/" class="group block no-underline">
        <div
          class="overflow-hidden rounded-xl border border-border transition-colors group-hover:border-primary/30"
        >
          <div
            class="relative flex h-36 items-center justify-center overflow-hidden bg-card sm:h-40"
          >
            <img
              src="/images/projects/dinar-echange/screenshot-currencies.png"
              alt="Dinar Échange currency rates screen"
              class="!m-0 h-full !rounded-none object-contain transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <p
              class="font-heading text-base font-normal text-foreground transition-colors group-hover:text-primary sm:text-lg"
            >
              Dinar Échange
            </p>
            <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
              Algerian dinar exchange rates. Because a friend asked.
            </p>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- Divider -->
  <div class="flex items-center gap-4">
    <div class="h-px flex-1 bg-border"></div>
    <h2 class="font-mono text-[0.5rem] uppercase tracking-[0.3em] text-muted-foreground/40">
      Writing
    </h2>
    <div class="h-px flex-1 bg-border"></div>
  </div>

  <!-- Writing -->
  <section class="py-12 sm:py-16">
    <div class="mb-8 flex items-end justify-between">
      <p class="font-heading text-2xl font-normal sm:text-3xl">Recent writing</p>
      <LinkButton variant="outline" size="xs" href="/blog/">All posts</LinkButton>
    </div>

    <div class="divide-y divide-border">
      {
        posts.map((post, i) => (
          <a
            href={`/blog/${post.id}/`}
            class="group flex items-center gap-5 py-4 no-underline sm:py-5"
          >
            <span class="hidden font-mono text-[0.625rem] text-muted-foreground/30 sm:block">
              {String(i + 1).padStart(2, '0')}
            </span>
            {post.data.featuredImage && (
              <div class="hidden shrink-0 overflow-hidden rounded-lg sm:block">
                <Image
                  src={post.data.featuredImage}
                  alt={post.data.title}
                  width={72}
                  height={48}
                  class="!m-0 !rounded-none object-cover transition-transform duration-500 group-hover:scale-[1.05]"
                  style="width: 72px; height: 48px;"
                />
              </div>
            )}
            <div class="min-w-0 flex-1">
              <p class="font-heading text-base font-normal text-foreground transition-colors group-hover:text-primary sm:text-lg">
                {post.data.title}
              </p>
              {post.data.description && (
                <p class="mt-0.5 hidden text-xs text-muted-foreground/60 sm:line-clamp-1 sm:block">
                  {post.data.description}
                </p>
              )}
            </div>
            <time class="shrink-0 font-mono text-[0.625rem] text-muted-foreground/40">
              {formatDateShort(post.data.date)}
            </time>
          </a>
        ))
      }
    </div>
  </section>
</Base>
