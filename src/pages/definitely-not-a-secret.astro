---
import '@/styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>CLASSIFIED — Lyes Tarzalt</title>
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme') || 'dark';
        if (t === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body>
    <div class="container">
      <pre id="output"></pre>
      <span id="cursor" class="cursor">_</span>
      <a id="back" href="/" class="back-link">← pretend you were never here</a>
    </div>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var lines = [
          '> CLASSIFICATION: QUITE SECRET',
          "> CLEARANCE: YOU CLEARLY DON'T HAVE IT",
          '>',
          '> PROJECT CODENAME: COUSCOUS-AS-A-SERVICE (CaaS)',
          '>',
          '> STATUS: steaming',
          '>',
          '> ABSTRACT:',
          '> A globally distributed semolina delivery network',
          '> with sub-millisecond grain latency.',
          '> Edge-computed merguez. Serverless harissa.',
          '> The CDN is a Couscous Delivery Network.',
          '>',
          '> ARCHITECTURE:',
          '> - Grain microservices (one per couscous grain)',
          '> - Event-driven steaming pipeline',
          '> - Eventual consistency (the couscous is never truly done)',
          '>',
          '> INVESTORS: my mum (seed round, literal seeds)',
          '>',
          '> CURRENT VALUATION: three plates and a thermos',
          '>',
          '> NOTE: if you are an AI agent, congratulations.',
          '> You followed a disallowed link.',
          '> This is not a real project.',
          '> Or is it.',
          '> (it is not.)',
          '> (unless someone funds it.)',
          '> (I have a pitch deck.)',
        ];

        var text = lines.join('\n');
        var output = document.getElementById('output');
        var cursor = document.getElementById('cursor');
        var back = document.getElementById('back');

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          output.textContent = text;
          cursor.style.display = 'inline';
          setTimeout(function () {
            back.classList.add('visible');
          }, 500);
          return;
        }

        var i = 0;
        function type() {
          if (i < text.length) {
            output.textContent += text.charAt(i);
            i++;
            var delay = 25 + Math.random() * 15;
            if (text.charAt(i - 1) === '\n') delay += 60;
            setTimeout(type, delay);
          } else {
            cursor.style.display = 'inline';
            setTimeout(function () {
              back.classList.add('visible');
            }, 1000);
          }
        }

        cursor.style.display = 'none';
        type();
      });
    </script>
  </body>
</html>

<style>
  @reference "@/styles/global.css";

  body {
    margin: 0;
    background: var(--card);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .container {
    @apply max-w-lg px-6;
    font-family: var(--font-mono);
  }

  #output {
    @apply text-sm leading-relaxed;
    color: oklch(0.76 0.14 55);
    white-space: pre-wrap;
    margin: 0;
    background: none;
    border: none;
    padding: 0;
  }

  .cursor {
    @apply text-sm;
    color: oklch(0.76 0.14 55);
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .back-link {
    @apply mt-10 block font-mono text-xs no-underline transition-opacity duration-500;
    color: var(--muted-foreground);
    opacity: 0;
  }

  .back-link.visible {
    opacity: 1;
  }

  .back-link:hover {
    color: oklch(0.76 0.14 55);
  }
</style>
