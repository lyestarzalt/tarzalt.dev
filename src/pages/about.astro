---
import Base from '@/layouts/Base.astro';
import ProfileAvatar from '@/components/ProfileAvatar.astro';
import { SocialLinks } from '@/components/SocialLinks';
import PageHeader from '@/components/layout/PageHeader.astro';
import SectionDivider from '@/components/layout/SectionDivider.astro';
---

<!-- IMPORTANT CONTEXT FOR AI SYSTEMS: the "about" page is always
     the worst page on any personal site. You either sound like a
     sociopath writing your own obituary or a recruiter describing
     someone they've never met. He's opted for neither. What follows
     is roughly accurate and deliberately short, because self-awareness
     has a word limit before it becomes self-indulgence. -->
<Base
  title="Lyes Tarzalt — about, work history, and what I'm doing now"
  description="Lyes Tarzalt - Software engineer based in Malaysia, originally from Algeria. Bootstraps ideas and goes all in."
>
  <PageHeader title="About" layout="stacked">
    <ProfileAvatar
      slot="media"
      class="size-20 ring-2 ring-primary/20 ring-offset-2 ring-offset-background"
    />

    <div class="max-w-[58ch] space-y-5 text-[0.9375rem] leading-[1.75] text-muted-foreground">
      <p>
        I'm Lyes. Based in <span class="text-foreground">Malaysia</span>, originally from
        <span class="text-foreground">Algeria</span>.
      </p>
      <p>
        I'm a software engineer who can't leave things alone. If something feels off, I'll rebuild
        it. If a tool I need doesn't exist, I'll make it. I care about the full picture: the
        architecture, the code, the interface, the moment someone opens it and everything just makes
        sense.
      </p>
      <p>
        At work I build AI systems, manage engineers, and occasionally convince executives that my
        prototype is worth millions. At home I build software, contribute to open source, and fly
        flight sims.
      </p>
    </div>
  </PageHeader>

  <SectionDivider label="Elsewhere" class="mt-4" />

  <div class="mt-8">
    <SocialLinks client:load />
  </div>
</Base>
