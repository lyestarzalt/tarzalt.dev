---
import Base from '@/layouts/Base.astro';
import { ProfileAvatar } from '@/components/ProfileAvatar';
import { Separator } from '@/components/ui/separator';
import { SocialLinks } from '@/components/SocialLinks';
---

<Base title="About - Lyes Tarzalt" description="Lyes Tarzalt - Software engineer based in Malaysia, originally from Algeria.">
  <section class="max-w-lg">
    <div class="mb-8 flex items-center gap-4">
      <ProfileAvatar src="https://avatars.githubusercontent.com/u/24894134?s=400&u=6c28a615dd7dc368f8e0f3085e2ef038df70b238&v=4" alt="Lyes Tarzalt" fallback="LT" className="size-16" />
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Lyes Tarzalt</h1>
        <p class="text-sm text-muted-foreground">Software Engineer</p>
      </div>
    </div>

    <div class="space-y-4 text-base leading-relaxed text-muted-foreground">
      <p>I'm a software engineer based in Malaysia, originally from Algeria.</p>
      <p>
        I like problems that make people say "that's too complicated" or "nobody's going to fix that."
        The kind where the real answer isn't writing more code, it's asking why the problem exists in the first place.
      </p>
      <p>
        Day to day, I write code. But what I actually enjoy is zooming out: figuring out which problems
        are worth solving and making sure they stay solved.
      </p>
    </div>

    <Separator className="my-10" />

    <h2 class="mb-4 text-sm font-medium text-foreground">Connect</h2>
    <SocialLinks client:load />
  </section>
</Base>
