---
import Base from '@/layouts/Base.astro';
import ProfileAvatar from '@/components/ProfileAvatar.astro';
import { SocialLinks } from '@/components/SocialLinks';
---

<Base
  title="About - Lyes Tarzalt"
  description="Lyes Tarzalt - Software engineer based in Malaysia, originally from Algeria. Bootstraps ideas and goes all in."
>
  <section class="max-w-lg pt-12 sm:pt-16">
    <ProfileAvatar
      class="mb-8 size-20 ring-2 ring-primary/20 ring-offset-2 ring-offset-background"
    />

    <h1 class="font-heading text-4xl font-normal tracking-tight sm:text-5xl">About</h1>

    <div class="mt-10 space-y-6 text-[0.9375rem] leading-[1.8] text-muted-foreground">
      <p>
        I'm Lyes. Based in <span class="text-foreground">Malaysia</span>, originally from <span
          class="text-foreground">Algeria</span
        >.
      </p>
      <p>
        I'm a software engineer who can't leave things alone. If something feels off, I'll rebuild
        it. If a tool I need doesn't exist, I'll make it. I care about the full picture: the
        architecture, the code, the interface, the moment someone opens it and everything just makes
        sense.
      </p>
      <p>
        At work I build AI systems, manage engineers, and occasionally convince executives that my
        prototype is worth millions. At home I build software, contribute to open source, and fly
        flight sims.
      </p>
    </div>

    <div class="mt-12 flex items-center gap-4">
      <div class="h-px flex-1 bg-border"></div>
      <span class="font-mono text-[0.5rem] uppercase tracking-[0.3em] text-muted-foreground/60">
        Elsewhere
      </span>
      <div class="h-px flex-1 bg-border"></div>
    </div>

    <div class="mt-8">
      <SocialLinks client:load />
    </div>
  </section>
</Base>
