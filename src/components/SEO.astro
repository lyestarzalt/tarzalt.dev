---
type JsonLdItem = Record<string, unknown>;

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  modifiedDate?: Date;
  tags?: string[];
  // Extra page-specific JSON-LD (e.g. SoftwareApplication on project pages).
  jsonLd?: JsonLdItem | JsonLdItem[];
}

const {
  title,
  description,
  image = '/images/profile.png',
  type = 'website',
  publishedDate,
  modifiedDate,
  tags = [],
  jsonLd,
} = Astro.props;

const extraJsonLd: JsonLdItem[] = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const siteName = 'Lyes Tarzalt';
const siteURL = Astro.site?.toString() || 'https://tarzalt.dev';

// Title with consistent branding
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// Breadcrumb structured data
const pathname = Astro.url.pathname;
const segments = pathname.split('/').filter(Boolean);
const labelMap: Record<string, string> = {
  blog: 'Writing',
  projects: 'Projects',
  about: 'About',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
    ...segments.map((seg, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: i === segments.length - 1 ? title : labelMap[seg] || seg.replace(/-/g, ' '),
      item: new URL('/' + segments.slice(0, i + 1).join('/') + '/', Astro.site).toString(),
    })),
  ],
};

// JSON-LD structured data — emitted as a connected graph so Google
// can resolve Person ↔ WebSite ↔ WebPage relationships from any node.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteURL}#person`,
  name: 'Lyes Tarzalt',
  url: siteURL,
  jobTitle: 'Software Engineer',
  knowsAbout: ['shipping software', 'choosing fonts', 'leaving things alone (reportedly)'],
  sameAs: ['https://github.com/lyestarzalt', 'https://linkedin.com/in/lyes-tarzalt'],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalURL.toString()}#webpage`,
  url: canonicalURL.toString(),
  name: fullTitle,
  description,
  isPartOf: { '@id': `${siteURL}#website` },
  about: { '@id': `${siteURL}#person` },
  inLanguage: 'en',
};

const articleSchema =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: description,
        url: canonicalURL.toString(),
        image: {
          '@type': 'ImageObject',
          url: imageURL.toString(),
          width: 1200,
          height: 630,
        },
        datePublished: publishedDate?.toISOString(),
        dateModified: modifiedDate?.toISOString() || publishedDate?.toISOString(),
        author: { '@id': `${siteURL}#person` },
        publisher: { '@id': `${siteURL}#person` },
        ...(tags.length > 0 && { keywords: tags.join(', ') }),
        ...(tags[0] && { articleSection: tags[0] }),
        mainEntityOfPage: { '@id': `${canonicalURL.toString()}#webpage` },
      }
    : null;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteURL}#website`,
  name: siteName,
  url: siteURL,
  publisher: { '@id': `${siteURL}#person` },
  inLanguage: 'en',
};
---

<!-- Primary Meta -->
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content="Lyes Tarzalt" />
<meta name="theme-color" content="#1a1d2e" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />
{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
{modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
{type === 'article' && <meta property="article:author" content={siteURL} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- RSS -->
<link rel="alternate" type="application/rss+xml" title="Lyes Tarzalt" href="/rss.xml" />

<!-- JSON-LD Structured Data -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
{
  articleSchema && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  )
}
{
  segments.length > 0 && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )
}
{
  extraJsonLd.map((item) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
  ))
}
