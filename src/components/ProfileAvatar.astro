---
import { Image } from 'astro:assets';
import profileImg from '@/assets/profile.png';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`relative shrink-0 overflow-hidden rounded-full ${className}`}>
  <Image
    src={profileImg}
    alt="Lyes Tarzalt"
    width={96}
    height={96}
    loading="eager"
    class="aspect-square size-full object-cover"
  />
</div>
