---
interface Props {
  src: string;
  caption?: string;
  alt?: string;
}

const { src, caption, alt } = Astro.props;
---

<figure class="my-8 text-center">
  <img
    src={src}
    alt={alt || caption || ''}
    loading="lazy"
    class="w-full rounded-lg border border-border"
  />
  {
    caption && (
      <figcaption class="mt-3 font-mono text-xs text-muted-foreground">{caption}</figcaption>
    )
  }
</figure>
